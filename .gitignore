# Secrets — Rule 11. Never commit credentials.
.env
.env.*
!.env.example
*.pem
*.key
service-account*.json
credentials*.json
gcp-*.json

# Local config may contain internal URLs / tuning; ship the example instead.
config.yaml

# Runtime state and artifacts.
# data/revenue/input/ holds CRM exports containing seller records. It is
# covered by the wildcard below; do not add an exception for it.
data/*
!data/.gitkeep
!data/screenshots/
data/screenshots/*
!data/screenshots/.gitkeep
reports/*
!reports/.gitkeep
logs/*
!logs/.gitkeep

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
