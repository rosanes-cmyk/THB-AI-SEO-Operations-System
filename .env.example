# THB AI SEO Operations System — environment template.
# Copy to .env and fill in. NEVER commit .env (see .gitignore).
#
#   cp .env.example .env && chmod 600 .env

# ---------------------------------------------------------------------------
# Claude (analysis engine)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
# Model used for reasoning + vision. Leave unset to use the built-in default.
THB_CLAUDE_MODEL=claude-opus-5
# low | medium | high | xhigh | max
THB_CLAUDE_EFFORT=high

# ---------------------------------------------------------------------------
# Google Chat (notifications). Incoming-webhook URL.
# If unset, incidents are still recorded to disk — Chat failure is never fatal.
# ---------------------------------------------------------------------------
GOOGLE_CHAT_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# PageSpeed Insights. Optional — without a key the collector reports
# "unavailable" rather than guessing (Rule 7).
# ---------------------------------------------------------------------------
PAGESPEED_API_KEY=

# ---------------------------------------------------------------------------
# WordPress remediation adapter.
# PRODUCTION WRITES ARE OFF BY DEFAULT AND MUST STAY OFF UNTIL STAGE 8.
# Setting THB_WORDPRESS_WRITES_ENABLED=true alone is not sufficient; each
# action must also be permitted by actions/policy.py and carry an approval.
# ---------------------------------------------------------------------------
WORDPRESS_BASE_URL=
WORDPRESS_USERNAME=
WORDPRESS_APP_PASSWORD=
THB_WORDPRESS_WRITES_ENABLED=false

# ---------------------------------------------------------------------------
# Optional external dead-man / uptime ping (e.g. healthchecks.io).
# Failure to ping is logged and never fatal.
# ---------------------------------------------------------------------------
THB_HEALTHCHECK_PING_URL=

# ---------------------------------------------------------------------------
# Paths / runtime
# ---------------------------------------------------------------------------
THB_CONFIG_PATH=config.yaml
THB_DATA_DIR=data
THB_REPORTS_DIR=reports
THB_LOG_DIR=logs
THB_LOG_LEVEL=INFO
