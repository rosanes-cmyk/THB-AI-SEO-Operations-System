# THB AI SEO Operations System — environment template.
# Copy to .env and fill in. NEVER commit .env (see .gitignore).
#
#   cp .env.example .env && chmod 600 .env

# ---------------------------------------------------------------------------
# Claude (analysis engine)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
# Model used for reasoning + vision. Leave unset to use the built-in default.
THB_CLAUDE_MODEL=claude-opus-5
# low | medium | high | xhigh | max
THB_CLAUDE_EFFORT=high

# ---------------------------------------------------------------------------
# Google Chat (notifications). Incoming-webhook URL.
# If unset, incidents are still recorded to disk — Chat failure is never fatal.
# ---------------------------------------------------------------------------
GOOGLE_CHAT_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# PageSpeed Insights. Optional — without a key the collector reports
# "unavailable" rather than guessing (Rule 7).
# ---------------------------------------------------------------------------
PAGESPEED_API_KEY=

# ---------------------------------------------------------------------------
# WordPress remediation adapter.
# PRODUCTION WRITES ARE OFF BY DEFAULT AND MUST STAY OFF UNTIL STAGE 8.
# Setting THB_WORDPRESS_WRITES_ENABLED=true alone is not sufficient; each
# action must also be permitted by actions/policy.py and carry an approval.
# ---------------------------------------------------------------------------
WORDPRESS_BASE_URL=
WORDPRESS_USERNAME=
WORDPRESS_APP_PASSWORD=
THB_WORDPRESS_WRITES_ENABLED=false

# ---------------------------------------------------------------------------
# Optional external dead-man / uptime ping (e.g. healthchecks.io).
# Failure to ping is logged and never fatal.
# ---------------------------------------------------------------------------
THB_HEALTHCHECK_PING_URL=

# ---------------------------------------------------------------------------
# Paths / runtime
# ---------------------------------------------------------------------------
THB_CONFIG_PATH=config.yaml
THB_DATA_DIR=data
THB_REPORTS_DIR=reports
THB_LOG_DIR=logs
THB_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Google Search Console (Stage 4) and GA4 (Stage 5).
#
# Both read through one service account. Your site already runs Site Kit, so
# the properties exist — the service account just needs to be granted access.
#
#   1. Google Cloud Console -> create a service account -> download JSON key
#   2. Enable "Google Search Console API" and "Google Analytics Data API"
#   3. Search Console -> Settings -> Users and permissions -> add the service
#      account email as a Full or Restricted user
#   4. GA4 -> Admin -> Property Access Management -> add it as Viewer
#
# NEVER commit the JSON key. Keep it outside the repo, or in a path the
# .gitignore already covers.
# ---------------------------------------------------------------------------
GOOGLE_APPLICATION_CREDENTIALS=/etc/thb/google-service-account.json

# Must match the property exactly as Search Console lists it, including the
# trailing slash. Domain properties look like: sc-domain:twinhomebuyer.com
THB_SEARCH_CONSOLE_PROPERTY=https://www.twinhomebuyer.com/

# GA4 numeric property ID (Admin -> Property Settings), digits only.
THB_GA4_PROPERTY_ID=
